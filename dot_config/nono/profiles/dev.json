{
  "$schema": "https://nono.dev/schemas/nono-profile.schema.json",
  "extends": ["base"],
  "meta": {
    "name": "dev",
    "description": "Language and systems development toolchains — Go, JS/TS, Python, Rust, and C/C++"
  },
  "filesystem": {
    "allow": [
      "~/.cache/go/pkg/mod",
      "~/.cache/go-build",
      "~/.cache/pip",
      "~/.cache/uv",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.cache/sccache",
      "~/.cmake"
    ],
    "read": [
      "~/.config/gh",
      "~/.local/share/mise/installs/go/1.26.5",
      "~/.local/share/mise/installs/python",
      "~/.local/share/mise/installs/aqua-astral-sh-uv",
      "~/.local/share/rustup",
      "~/.cargo/bin",
      "~/.local/share/mise/installs/aqua-mozilla-sccache",
      "/usr/include",
      "/usr/local/include"
    ],
    "read_file": [
      "~/.config/npm/npmrc",
      "~/.config/sccache/config"
    ]
  }
}
